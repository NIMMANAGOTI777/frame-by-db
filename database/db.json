    {
      "id": "faq2",
      "question": "Do you travel outstation or internationally for shoots?",
      "answer": "Yes, we travel globally. While we are based in Hyderabad, we have shot projects across India, South East Asia, and the Middle East. Travel and accommodation fees are billed additionally.",
      "category": "General"
    },
